# Copie este archivo como .env y complete los datos de su proyecto (Supabase > Project Settings > API).
# En Vercel, escriba las mismas variables en Settings > Environment Variables.
SUPABASE_URL=https://su-proyecto.supabase.co
# Clave pública "anon" o "publishable". NUNCA la service_role / secret.
SUPABASE_ANON_KEY=
